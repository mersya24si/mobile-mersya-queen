<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Home.HomeFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#C5AB75"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Dashboard"
        app:titleTextColor="#FFFFFF" />

    <ImageView
        android:id="@+id/imageViewLogo"
        android:layout_width="180dp"
        android:layout_height="130dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <TextView
        android:id="@+id/tvWelcomeHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="Selamat Datang!"
        android:textColor="#2A355A"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewLogo" />

    <TextView
        android:id="@+id/tvNamaUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-black"
        android:text="Username"
        android:textColor="#C5AB75"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWelcomeHeader" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:text="Silahkan pilih menu di bawah ini untuk menjelajahi aplikasi."
        android:textColor="#8F9BB3"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNamaUser" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/layoutMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        app:alignmentMode="alignMargins"
        app:columnCount="2"
        app:layout_constraintTop_toBottomOf="@+id/tvDescription">

        <Button
            android:id="@+id/btnBangunRuang"
            android:layout_width="0dp"
            android:layout_height="70dp"
            app:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#F8F9FA"
            android:fontFamily="@font/poppins"
            android:text="Bangun\nRuang"
            android:textAllCaps="false"
            android:textColor="#2A355A"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="#E4E7EB"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnProfilAplikasi"
            android:layout_width="0dp"
            android:layout_height="70dp"
            app:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#F8F9FA"
            android:fontFamily="@font/poppins"
            android:text="Profil\nAplikasi"
            android:textAllCaps="false"
            android:textColor="#2A355A"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="#E4E7EB"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnProfilPengembang"
            android:layout_width="0dp"
            android:layout_height="70dp"
            app:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#F8F9FA"
            android:fontFamily="@font/poppins"
            android:text="Profil\nPengembang"
            android:textAllCaps="false"
            android:textColor="#2A355A"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="#E4E7EB"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnWebView"
            android:layout_width="0dp"
            android:layout_height="70dp"
            app:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#F8F9FA"
            android:fontFamily="@font/poppins"
            android:text="Bina Desa\nProduk Hukum"
            android:textAllCaps="false"
            android:textColor="#2A355A"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="#E4E7EB"
            app:strokeWidth="1dp" />

    </androidx.gridlayout.widget.GridLayout>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#C5AB75"
        android:fontFamily="@font/poppins"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>